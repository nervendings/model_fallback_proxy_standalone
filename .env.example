# Copy to ~/.config/codex-model-fallback-proxy-standalone/environment and chmod 600.
# Do not commit the copied file.
CODEX_FALLBACK_UPSTREAM_URL=https://api.example.invalid
CODEX_FALLBACK_LISTEN_HOST=127.0.0.1
CODEX_FALLBACK_LISTEN_PORT=4477
CODEX_FALLBACK_MODEL_CHAIN=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
CODEX_FALLBACK_COOLDOWN_SECONDS=180

CODEX_AUTO_CONTINUE_FOREGROUND=1
CODEX_AUTO_CONTINUE_BACKGROUND_FALLBACK=1
CODEX_AUTO_CONTINUE_FRONTEND_CHANNEL=auto
CODEX_AUTO_CONTINUE_TERMINAL_PTY=0
CODEX_AUTO_CONTINUE_TERMINAL_ASSUME_READY=0
CODEX_AUTO_CONTINUE_LINUX_NOTIFY=1
CODEX_AUTO_CONTINUE_NOTIFY_BIN=notify-send
CODEX_AUTO_CONTINUE_NOTIFY_INTERVAL=600
CODEX_AUTO_CONTINUE_FEISHU_NOTIFY=0
CODEX_AUTO_CONTINUE_FEISHU_CHAT_ID=
CODEX_AUTO_CONTINUE_FEISHU_AS=bot
CODEX_AUTO_CONTINUE_FEISHU_NOTIFY_INTERVAL=600
CODEX_AUTO_CONTINUE_CODEX_BIN=codex
