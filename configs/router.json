      },
      "children": [
        "deepseek-v4-1-flash-261017"
      ]
    },
    "deepseek-v4-1-flash-261017": {
      "provider": "ark-official",
      "comment": "全链最后一站（根）：方舟官方 /api/v3 按量计费，专用 key。前置链路全部不可用时才走到这里；自身无下级。",
      "policy": {
        "retries": 1,
        "cooldown_s": 300,
        "first_byte_timeout_s": 90
      },
      "children": []
    },
    "*": {
      "provider": "ark-official",
      "remote_model": "deepseek-v4-1-flash-261017",
      "comment": "全局兜底（通配）：任何未在链路里的模型、任何走不到根的分支，失败后都会落到这里",
      "policy": {
        "retries": 0,
        "cooldown_s": 300
      },
      "children": []
    }
  },
  "special_rules": [
    {
      "name": "context_overflow",
      "patterns": [
        "400001",
        "read body failed",
        "context_length_exceeded",
        "maximum context length",
        "range of input length"
      ],
      "actions": [
        "switch_next",
        "signal_compact"
      ],
      "cooldown": false,
      "enabled": true
    },
    {
      "name": "corrupted_history",
      "patterns": [
        "could not be decrypted or parsed",
        "invalid content type: encrypted_content",
        "encrypted content hydration",
        "hydration failed"
      ],
      "actions": [
        "signal_new_session"
      ],
      "cooldown": false,
      "enabled": true
    }
  ],
