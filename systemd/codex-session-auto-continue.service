[Unit]
Description=Codex TUI automatic continuation watcher
After=network-online.target codex-model-fallback-proxy.service

[Service]
Type=simple
WorkingDirectory=%h
Environment=CODEX_AUTO_CONTINUE_FOREGROUND=1
Environment=CODEX_AUTO_CONTINUE_BACKGROUND_FALLBACK=1
Environment=CODEX_AUTO_CONTINUE_FRONTEND_CHANNEL=auto
Environment=CODEX_AUTO_CONTINUE_TERMINAL_PTY=0
Environment=CODEX_AUTO_CONTINUE_TERMINAL_ASSUME_READY=0
EnvironmentFile=-%h/.config/codex-model-fallback-proxy/environment
ExecStart=%h/model_fallback_proxy_standalone/.venv/bin/python %h/model_fallback_proxy_standalone/session_auto_continue.py
Restart=always
RestartSec=3
TimeoutStopSec=20
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077

[Install]
WantedBy=default.target
