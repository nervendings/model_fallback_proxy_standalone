[Unit]
Description=Continue Engineer model capacity fallback proxy
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/model_fallback_proxy_standalone
ExecStart=%h/model_fallback_proxy_standalone/scripts/runtime/run_proxy.sh
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONPATH=%h/model_fallback_proxy_standalone/src
Environment=CODEX_FALLBACK_LISTEN_HOST=127.0.0.1
Environment=CODEX_FALLBACK_LISTEN_PORT=4477
Environment=CODEX_FALLBACK_COOLDOWN_SECONDS=180
EnvironmentFile=-%h/.config/codex-model-fallback-proxy-standalone/environment
Restart=always
RestartSec=2
TimeoutStopSec=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true
RestrictRealtime=true
UMask=0077

[Install]
WantedBy=default.target
